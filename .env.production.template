# Production Environment Configuration
# Copy this to .env and replace all values with actual production values

# CRITICAL: Environment Mode - MUST be 'production'
NODE_ENV=production

# Server Configuration
PORT=3000
FRONTEND_URL=https://your-frontend-domain.com

# AWS Configuration for Secrets Manager
USE_AWS_SECRETS=true
AWS_REGION=us-east-1

# Firebase Production Project (replace with your actual project)
FIREBASE_PROJECT_ID=your-production-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-production-firebase-project-id.appspot.com

# Blockchain Configuration (Production Networks)
# Replace with actual production RPC URLs
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
ARBITRUM_SEPOLIA_RPC_URL=https://arbitrum-sepolia.infura.io/v3/YOUR_INFURA_KEY
POLYGON_AMOY_RPC_URL=https://polygon-amoy.infura.io/v3/YOUR_INFURA_KEY

# CRITICAL: DO NOT SET THESE IN PRODUCTION
# FIRESTORE_EMULATOR_HOST=
# FIREBASE_AUTH_EMULATOR_HOST=
# FIREBASE_STORAGE_EMULATOR_HOST=

# CRITICAL: DO NOT SET TEST VALUES
# DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# BACKEND_WALLET_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d